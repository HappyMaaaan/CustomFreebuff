{
  "id": "solarized-dark",
  "name": "Solarized Dark",
  "description": "Ethan Schoonover's classic — low contrast and warm, with deeper surfaces.",
  "colorScheme": "dark",
  "base": "default",
  "tokens": {
    "background": "#002b36",
    "surface": "#073642",
    "text": "#eee8d5",
    "textMuted": "#93a1a1",
    "border": "#405b65",
    "accent": "#2aa198"
  },
  "shape": {
    "radius": 8,
    "borderWidth": 1,
    "borderOpacity": 1
  },
  "shadow": {
    "layers": [
      {
        "x": 0,
        "y": 2,
        "blur": 10,
        "spread": 0,
        "color": "#000000",
        "opacity": 0.18,
        "inner": false
      }
    ]
  },
  "effects": {
    "enabled": false,
    "mode": "none",
    "transparency": 1,
    "blur": 0,
    "saturation": 1,
    "brightness": 1,
    "borderTranslucency": 1,
    "glow": 0,
    "gradient": 0,
    "grain": 0,
    "performance": "auto"
  },
  "motion": {
    "preset": "smooth",
    "duration": 200,
    "easing": "ease-out",
    "delay": 0,
    "hover": {
      "translateY": -2,
      "scale": 1.02
    },
    "active": {
      "scale": 0.97
    },
    "focus": {
      "scale": 1.01
    },
    "enter": true,
    "global": {
      "speed": 1,
      "intensity": 1,
      "reduced": "auto"
    }
  },
  "extraCss": "",
  "cssScope": "app"
}
