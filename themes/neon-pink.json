{
  "id": "neon-pink",
  "name": "Neon Pink",
  "description": "Bold hot pink on dark charcoal — neon glow, frosted glass and a bouncy feel.",
  "colorScheme": "dark",
  "base": "default",
  "tokens": {
    "background": "#170f17",
    "surface": "#221623",
    "text": "#ffe3f1",
    "textMuted": "#c58aa8",
    "border": "#4a2b3f",
    "accent": "#ff2e88"
  },
  "shape": {
    "radius": 14,
    "borderWidth": 1,
    "borderOpacity": 0.9
  },
  "shadow": {
    "layers": [
      {
        "x": 0,
        "y": 2,
        "blur": 10,
        "spread": 0,
        "color": "#000000",
        "opacity": 0.18,
        "inner": false
      },
      {
        "x": 0,
        "y": 0,
        "blur": 12,
        "spread": 0,
        "color": "#ff2e88",
        "opacity": 0.22,
        "inner": false
      }
    ]
  },
  "effects": {
    "enabled": true,
    "mode": "frosted",
    "transparency": 0.88,
    "blur": 10,
    "saturation": 1.15,
    "brightness": 1,
    "borderTranslucency": 0.5,
    "glow": 0.12,
    "gradient": 0.1,
    "grain": 0,
    "performance": "auto"
  },
  "motion": {
    "preset": "bouncy",
    "duration": 300,
    "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "delay": 0,
    "hover": {
      "translateY": -2,
      "scale": 1.02
    },
    "active": {
      "scale": 0.97
    },
    "focus": {
      "scale": 1.01
    },
    "enter": true,
    "global": {
      "speed": 1,
      "intensity": 1,
      "reduced": "auto"
    }
  },
  "extraCss": "",
  "cssScope": "app"
}
