{
  "id": "midnight",
  "name": "Midnight",
  "description": "Deep indigo night — floating surfaces, frosted glass and a calm, smooth feel.",
  "colorScheme": "dark",
  "base": "default",
  "tokens": {
    "background": "#0b1026",
    "surface": "#131a36",
    "text": "#e6eaff",
    "textMuted": "#8f9ac4",
    "border": "#2b3663",
    "accent": "#6ea8ff"
  },
  "shape": {
    "radius": 12,
    "borderWidth": 1,
    "borderOpacity": 0.9
  },
  "shadow": {
    "layers": [
      {
        "x": 0,
        "y": 2,
        "blur": 10,
        "spread": 0,
        "color": "#000000",
        "opacity": 0.2,
        "inner": false
      }
    ]
  },
  "effects": {
    "enabled": true,
    "mode": "frosted",
    "transparency": 0.86,
    "blur": 8,
    "saturation": 1.1,
    "brightness": 1,
    "borderTranslucency": 0.55,
    "glow": 0.08,
    "gradient": 0.06,
    "grain": 0,
    "performance": "auto"
  },
  "motion": {
    "preset": "smooth",
    "duration": 220,
    "easing": "ease-out",
    "delay": 0,
    "hover": {
      "translateY": -2,
      "scale": 1.02
    },
    "active": {
      "scale": 0.97
    },
    "focus": {
      "scale": 1.01
    },
    "enter": true,
    "global": {
      "speed": 1,
      "intensity": 1,
      "reduced": "auto"
    }
  },
  "extraCss": "",
  "cssScope": "app"
}
