{
  "id": "gruvbox",
  "name": "Gruvbox",
  "description": "Warm retro palette with earthy tones — soft shadows, no effects, smooth motion.",
  "colorScheme": "dark",
  "base": "default",
  "tokens": {
    "background": "#282828",
    "surface": "#2f2f2f",
    "text": "#ebdbb2",
    "textMuted": "#a89984",
    "border": "#504945",
    "accent": "#b8bb26"
  },
  "shape": {
    "radius": 8,
    "borderWidth": 1,
    "borderOpacity": 1
  },
  "shadow": {
    "layers": [
      {
        "x": 0,
        "y": 2,
        "blur": 10,
        "spread": 0,
        "color": "#000000",
        "opacity": 0.16,
        "inner": false
      }
    ]
  },
  "effects": {
    "enabled": false,
    "mode": "none",
    "transparency": 1,
    "blur": 0,
    "saturation": 1,
    "brightness": 1,
    "borderTranslucency": 1,
    "glow": 0,
    "gradient": 0,
    "grain": 0,
    "performance": "auto"
  },
  "motion": {
    "preset": "smooth",
    "duration": 200,
    "easing": "ease-out",
    "delay": 0,
    "hover": {
      "translateY": -2,
      "scale": 1.02
    },
    "active": {
      "scale": 0.97
    },
    "focus": {
      "scale": 1.01
    },
    "enter": true,
    "global": {
      "speed": 1,
      "intensity": 1,
      "reduced": "auto"
    }
  },
  "extraCss": "",
  "cssScope": "app"
}
